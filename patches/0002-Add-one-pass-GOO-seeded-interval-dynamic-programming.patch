 /* Keep each candidate's subplans, but expose its paths on one final joinrel. */
+static void
+goo_add_candidate_paths(PlannerInfo *root, RelOptInfo *target,
+						RelOptInfo *source, bool preserve)
+{
+	ListCell   *lc;
+
+	Assert(bms_equal(target->relids, source->relids));
+
+	foreach(lc, source->pathlist)
+	{
+		Path	   *path = lfirst(lc);
+
+		/* create_projection_path cannot stack on another ProjectionPath. */
+		if (IsA(path, ProjectionPath))
+			path = ((ProjectionPath *) path)->subpath;
+		path = (Path *) create_projection_path(root, target,
+											   path, target->reltarget);
+		if (preserve)
+			target->pathlist = lappend(target->pathlist, path);
+		else
+			add_path(target, path);
+	}
+
+	foreach(lc, source->partial_pathlist)
+	{
+		Path	   *path = lfirst(lc);
+
+		if (IsA(path, ProjectionPath))
+			path = ((ProjectionPath *) path)->subpath;
+		path = (Path *) create_projection_path(root, target,
+											   path, target->reltarget);
+		if (preserve)
+			target->partial_pathlist = lappend(target->partial_pathlist, path);
+		else
+			add_partial_path(target, path);
+	}
+}
+
+static void
+goo_restore_seed_paths(RelOptInfo *target, List *seed_paths,
+					   List *seed_partial_paths)
+{
+	target->pathlist = list_concat(target->pathlist, seed_paths);
+	list_sort(target->pathlist, goo_path_total_cost_compare);
+	target->partial_pathlist =
+		list_concat(target->partial_pathlist, seed_partial_paths);
+	list_sort(target->partial_pathlist, goo_path_total_cost_compare);
+	set_cheapest(target);
+}
+
+static int
+goo_path_total_cost_compare(const ListCell *a, const ListCell *b)
+{
+	return compare_path_costs(lfirst(a), lfirst(b), TOTAL_COST);
+}
 
