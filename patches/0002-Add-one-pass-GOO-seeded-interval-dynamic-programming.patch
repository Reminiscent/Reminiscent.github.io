diff --git a/src/backend/optimizer/path/lindp.c b/src/backend/optimizer/path/lindp.c
new file mode 100644
index 00000000000..80a82e81691
--- /dev/null
+++ b/src/backend/optimizer/path/lindp.c
@@ -0,0 +1,252 @@
+/*-------------------------------------------------------------------------
+ *
+ * lindp.c
+ *	  Linearized dynamic programming join search for large join problems
+ *
+ * This experimental join search implementation runs dynamic programming over
+ * contiguous intervals of one relation order.  It deliberately
+ * delegates join legality and path generation to the normal PostgreSQL
+ * machinery by calling make_join_rel().
+ *
+ * Portions Copyright (c) 1996-2026, PostgreSQL Global Development Group
+ * Portions Copyright (c) 1994, Regents of the University of California
+ *
+ * IDENTIFICATION
+ *	  src/backend/optimizer/path/lindp.c
+ *
+ *-------------------------------------------------------------------------
+ */
+
+#include "postgres.h"
+
+#include "lib/stringinfo.h"
+#include "miscadmin.h"
+#include "nodes/bitmapset.h"
+#include "optimizer/joininfo.h"
+#include "optimizer/lindp.h"
+#include "optimizer/pathnode.h"
+#include "optimizer/paths.h"
+
+
+typedef struct LinDPCell
+{
+	RelOptInfo *rel;
+} LinDPCell;
+
+typedef struct LinDPOrder
+{
+	const char *name;
+	RelOptInfo **rels;
+	int			nrels;
+} LinDPOrder;
+
+static RelOptInfo *lindp_run_order(PlannerInfo *root, int levels_needed,
+								   List *initial_rels, LinDPOrder *order);
+static bool lindp_split_worth_trying(PlannerInfo *root, RelOptInfo *left,
+									 RelOptInfo *right, bool allow_clauseless);
+static void lindp_finalize_level(PlannerInfo *root, int level);
+static void lindp_debug_order(LinDPOrder *order);
+
+RelOptInfo *
+lindp_join_search(PlannerInfo *root, int levels_needed, List *initial_rels,
+				  RelOptInfo **order_rels)
+{
+	LinDPOrder	order;
+	RelOptInfo *result;
+
+	Assert(levels_needed == list_length(initial_rels));
+	Assert(root->join_rel_level == NULL);
+
+	order.name = "goo_combined";
+	order.rels = order_rels;
+	order.nrels = levels_needed;
+
+	lindp_debug_order(&order);
+	result = lindp_run_order(root, levels_needed, initial_rels, &order);
+
+	if (result != NULL)
+		elog(DEBUG2, "LinDP goo_combined seed completed (cost: %.2f disabled_nodes: %d)",
+			 result->cheapest_total_path->total_cost,
+			 result->cheapest_total_path->disabled_nodes);
+
+	return result;
+}
+
+static RelOptInfo *
+lindp_run_order(PlannerInfo *root, int levels_needed,
+				List *initial_rels, LinDPOrder *order)
+{
+	LinDPCell  *cells;
+	RelOptInfo *result;
+	int			saved_level = root->join_cur_level;
+
+	Assert(levels_needed == order->nrels);
+	Assert(root->join_rel_level == NULL);
+
+	cells = palloc0_array(LinDPCell, (Size) order->nrels * order->nrels);
+
+#define LINDP_CELL(i, j) cells[(i) * order->nrels + (j)]
+
+	root->join_rel_level =
+		(List **) palloc0((levels_needed + 1) * sizeof(List *));
+	root->join_rel_level[1] = initial_rels;
+
+	for (int i = 0; i < order->nrels; i++)
+		LINDP_CELL(i, i).rel = order->rels[i];
+
+	for (int len = 2; len <= levels_needed; len++)
+	{
+		CHECK_FOR_INTERRUPTS();
+
+		root->join_cur_level = len;
+
+		for (int start = 0; start + len <= levels_needed; start++)
+		{
+			int			end = start + len - 1;
+
+			CHECK_FOR_INTERRUPTS();
+
+			for (int pass = 0; pass < 2; pass++)
+			{
+				bool		allow_clauseless = (pass == 1);
+
+				for (int split = start; split < end; split++)
+				{
+					RelOptInfo *left = LINDP_CELL(start, split).rel;
+					RelOptInfo *right = LINDP_CELL(split + 1, end).rel;
+					RelOptInfo *joinrel;
+
+					if (left == NULL || right == NULL)
+						continue;
+
+					if (!lindp_split_worth_trying(root, left, right,
+												  allow_clauseless))
+						continue;
+
+					joinrel = make_join_rel(root, left, right);
+					if (joinrel == NULL)
+						continue;
+
+					LINDP_CELL(start, end).rel = joinrel;
+				}
+
+				if (LINDP_CELL(start, end).rel != NULL)
+					break;
+			}
+		}
+
+		lindp_finalize_level(root, len);
+
+		for (int start = 0; start + len <= levels_needed; start++)
+		{
+			int			end = start + len - 1;
+			RelOptInfo *rel = LINDP_CELL(start, end).rel;
+
+			if (rel != NULL && rel->cheapest_total_path == NULL)
+				LINDP_CELL(start, end).rel = NULL;
+		}
+	}
+
+	result = LINDP_CELL(0, levels_needed - 1).rel;
+
+	pfree(root->join_rel_level);
+	root->join_rel_level = NULL;
+	root->join_cur_level = saved_level;
+
+	if (result != NULL && result->cheapest_total_path == NULL)
+		result = NULL;
+
+#undef LINDP_CELL
+
+	pfree(cells);
+
+	return result;
+}
+
+static bool
+lindp_split_worth_trying(PlannerInfo *root, RelOptInfo *left,
+						 RelOptInfo *right, bool allow_clauseless)
+{
+	if (have_relevant_joinclause(root, left, right) ||
+		have_join_order_restriction(root, left, right))
+		return true;
+
+	return allow_clauseless;
+}
+
+/*
+ * lindp_finalize_level
+ *		Finish path generation for all joinrels first created at this level.
+ */
+static void
+lindp_finalize_level(PlannerInfo *root, int level)
+{
+	ListCell   *lc;
+
+	foreach(lc, root->join_rel_level[level])
+	{
+		RelOptInfo *rel = lfirst_node(RelOptInfo, lc);
+		bool		is_top_rel;
+
+		is_top_rel = bms_equal(rel->relids, root->all_query_rels);
+
+		generate_partitionwise_join_paths(root, rel);
+		if (!is_top_rel)
+			generate_useful_gather_paths(root, rel, false);
+
+		if (rel->pathlist == NIL)
+			continue;
+
+		set_cheapest(rel);
+
+		if (rel->grouped_rel != NULL && !is_top_rel)
+		{
+			RelOptInfo *grouped_rel = rel->grouped_rel;
+
+			Assert(IS_GROUPED_REL(grouped_rel));
+
+			generate_grouped_paths(root, grouped_rel, rel);
+			if (grouped_rel->pathlist != NIL)
+				set_cheapest(grouped_rel);
+		}
+	}
+}
+
+/*
+ * lindp_debug_order
+ *		Emit the chosen linearization for development-time inspection.
+ */
+static void
+lindp_debug_order(LinDPOrder *order)
+{
+	StringInfoData buf;
+
+	if (!message_level_is_interesting(DEBUG1))
+		return;
+
+	initStringInfo(&buf);
+
+	for (int i = 0; i < order->nrels; i++)
+	{
+		RelOptInfo *rel = order->rels[i];
+		bool		first = true;
+		int			relid = -1;
+
+		if (i > 0)
+			appendStringInfoChar(&buf, ' ');
+
+		appendStringInfoChar(&buf, '{');
+		while ((relid = bms_next_member(rel->relids, relid)) >= 0)
+		{
+			if (!first)
+				appendStringInfoChar(&buf, ',');
+			appendStringInfo(&buf, "%d", relid);
+			first = false;
+		}
+		appendStringInfoChar(&buf, '}');
+	}
+
+	elog(DEBUG1, "LinDP %s join order: %s", order->name, buf.data);
+
+	pfree(buf.data);
+}
