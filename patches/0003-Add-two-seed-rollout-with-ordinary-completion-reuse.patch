 /* Complete one proposed join with ordinary GOO in separate joinrel lists. */
+static bool
+goo_rollout_complete(GooState *state, GooCandidate *candidate,
+					 int *disabled_nodes, Cost *total_cost,
+					 RelOptInfo **completed_rel,
+					 List **completed_join_rel_list)
+{
+	PlannerInfo *root = state->root;
+	List	   *saved_join_rel_list = root->join_rel_list;
+	struct HTAB *saved_hash = root->join_rel_hash;
+	GooState   *branch;
+	RelOptInfo *result;
+	MemoryContext oldcxt;
+
+	oldcxt = MemoryContextSwitchTo(root->planner_cxt);
+	root->join_rel_list = list_copy(saved_join_rel_list);
+	root->join_rel_hash = NULL;
+	MemoryContextSwitchTo(oldcxt);
+
+	branch = goo_init_state(root, state->clumps, state->strategy, false);
+	branch->probe_cache = state->probe_cache;
+	oldcxt = MemoryContextSwitchTo(branch->goo_cxt);
+	(void) goo_commit_join(branch, candidate);
+	result = goo_search_internal(branch);
+	MemoryContextSwitchTo(oldcxt);
+	if (result != NULL)
+	{
+		*disabled_nodes = result->cheapest_total_path->disabled_nodes;
+		*total_cost = result->cheapest_total_path->total_cost;
+		if (completed_rel != NULL)
+		{
+			*completed_rel = result;
+			*completed_join_rel_list = root->join_rel_list;
+		}
+	}
+	goo_destroy_state(branch);
+
+	/*
+	 * Branch joinrels remain in planner_cxt, but are not visible to this
+	 * search.
+	 */
+	root->join_rel_list = saved_join_rel_list;
+	root->join_rel_hash = saved_hash;
+	return result != NULL;
+}
 
