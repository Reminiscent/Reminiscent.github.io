+CREATE TABLE js_a (a integer, b integer);
+CREATE TABLE js_b (a integer, b integer);
+CREATE TABLE js_c (a integer, b integer);
+INSERT INTO js_a VALUES (1, 10), (1, 20), (2, 30), (NULL, 40);
+INSERT INTO js_b VALUES (1, 100), (2, 200), (3, 300);
+INSERT INTO js_c VALUES (1, 1000), (2, 2000), (NULL, 3000);
+ANALYZE js_a;
+ANALYZE js_b;
+ANALYZE js_c;
+SET join_search_method = dp;
+CREATE TEMP TABLE js_expected AS
+SELECT c.b AS c_value, a.b AS a_value, b.a AS b_value
+FROM js_a a JOIN js_b b ON a.a = b.a JOIN js_c c ON c.a = b.a;
+CREATE FUNCTION js_check(method text) RETURNS boolean LANGUAGE plpgsql AS $$
+DECLARE
+    matches boolean;
+BEGIN
+    PERFORM set_config('join_search_method', method, true);
+    EXECUTE $query$ WITH actual AS (
+        SELECT c.b AS c_value, a.b AS a_value, b.a AS b_value
+        FROM js_a a JOIN js_b b ON a.a = b.a JOIN js_c c ON c.a = b.a
+    ), difference AS (
+        (SELECT * FROM actual EXCEPT ALL SELECT * FROM js_expected)
+        UNION ALL
+        (SELECT * FROM js_expected EXCEPT ALL SELECT * FROM actual)
+    )
+    SELECT NOT EXISTS (SELECT FROM difference) $query$ INTO matches;
+    RETURN matches;
+END;
+$$;
+SELECT js_check('dp'), js_check('geqo'), js_check('goo_combined');
+ js_check | js_check | js_check 
+----------+----------+----------
+ t        | t        | t
+(1 row)
+
+SET join_search_method = goo_combined;
+SELECT count(*) FROM js_a, js_b, js_c;
+ count 
+-------
+    36
+(1 row)
+
+SELECT count(*) FROM js_a a LEFT JOIN js_b b ON a.a = b.a
+JOIN js_c c ON c.a = a.a;
+ count 
+-------
+     3
+(1 row)
+
+SET join_search_method = invalid;
+ERROR:  invalid value for parameter "join_search_method": "invalid"
+HINT:  Available values: auto, dp, geqo, goo_combined.
+RESET join_search_method;
+DROP FUNCTION js_check(text);
+DROP TABLE js_expected, js_a, js_b, js_c;
