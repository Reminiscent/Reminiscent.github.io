diff --git a/src/backend/optimizer/util/realcard.c b/src/backend/optimizer/util/realcard.c
new file mode 100644
index 00000000000..1a80374db9b
--- /dev/null
+++ b/src/backend/optimizer/util/realcard.c
@@ -0,0 +1,258 @@
+#include "postgres.h"
+
+#include <math.h>
+
+#include "catalog/pg_class.h"
+#include "catalog/namespace.h"
+#include "executor/spi.h"
+#include "lib/stringinfo.h"
+#include "miscadmin.h"
+#include "nodes/nodeFuncs.h"
+#include "optimizer/cost.h"
+#include "optimizer/extendplan.h"
+#include "optimizer/optimizer.h"
+#include "optimizer/realcard.h"
+#include "utils/builtins.h"
+#include "utils/hsearch.h"
+#include "utils/memutils.h"
+#include "utils/lsyscache.h"
+#include "utils/plancache.h"
+
+#define REALCARD_KEY_MAXLEN 256
+
+char	   *realcard_query_key = NULL;
+
+typedef struct RealCardEntry
+{
+	char		relids[REALCARD_KEY_MAXLEN];
+	double		rows;
+} RealCardEntry;
+
+typedef struct RealCardCache
+{
+	HTAB	   *entries;
+	char	   *query_key;
+	Oid			user_id;
+} RealCardCache;
+
+static bool realcard_loading;
+static int	realcard_extension_id = -1;
+
+void
+assign_realcard_query_key(const char *newval, void *extra)
+{
+	if (realcard_query_key != NULL && strcmp(realcard_query_key, newval) != 0)
+		ResetPlanCache();
+}
+
+static bool
+realcard_has_param(Node *node, void *context)
+{
+	if (node == NULL)
+		return false;
+	if (IsA(node, Param))
+		return true;
+	return expression_tree_walker(node, realcard_has_param, context);
+}
+
+static void
+realcard_check_scope(PlannerInfo *root)
+{
+	ListCell   *cell;
+
+	if (root->parent_root != NULL || root->parse->commandType != CMD_SELECT ||
+		root->parse->cteList != NIL || root->parse->hasSubLinks ||
+		root->parse->hasRowSecurity || root->parse->setOperations != NULL ||
+		root->hasLateralRTEs || root->join_info_list != NIL ||
+		(root->glob->boundParams != NULL && root->glob->boundParams->numParams > 0) ||
+		query_tree_walker(root->parse, realcard_has_param, NULL, 0))
+		ereport(ERROR,
+				(errcode(ERRCODE_FEATURE_NOT_SUPPORTED),
+				 errmsg("realcard replay requires a non-parameterized top-level inner-join query")));
+	foreach(cell, root->parse->rtable)
+	{
+		RangeTblEntry *rte = lfirst_node(RangeTblEntry, cell);
+
+		if (rte->rtekind == RTE_JOIN)
+			continue;
+		if (rte->rtekind != RTE_RELATION || rte->relkind != RELKIND_RELATION ||
+			rte->tablesample != NULL || rte->securityQuals != NIL)
+			ereport(ERROR,
+					(errcode(ERRCODE_FEATURE_NOT_SUPPORTED),
+					 errmsg("realcard replay supports only ordinary tables without row security or sampling")));
+	}
+}
+
+static void
+realcard_validate_key(PlannerInfo *root, const char *key)
+{
+	const char *position = key;
+	long		previous = 0;
+
+	if (*key == '\0' || strlen(key) >= REALCARD_KEY_MAXLEN)
+		goto invalid;
+	for (;;)
+	{
+		char	   *end;
+		long		index;
+
+		if (*position < '1' || *position > '9')
+			goto invalid;
+		errno = 0;
+		index = strtol(position, &end, 10);
+		if (errno != 0 || index <= previous || index >= root->simple_rel_array_size ||
+			root->simple_rel_array[index] == NULL ||
+			root->simple_rel_array[index]->reloptkind != RELOPT_BASEREL)
+			goto invalid;
+		if (*end == '\0')
+			return;
+		if (*end != ',')
+			goto invalid;
+		previous = index;
+		position = end + 1;
+	}
+invalid:
+	ereport(ERROR,
+			(errcode(ERRCODE_INVALID_PARAMETER_VALUE),
+			 errmsg("realcard: invalid relation subset key \"%s\"", key)));
+}
+
+static RealCardCache *
+realcard_load_cache(PlannerInfo *root)
+{
+	RealCardCache *cache;
+	MemoryContext oldcontext = MemoryContextSwitchTo(root->planner_cxt);
+	volatile bool connected = false;
+	Oid			argtypes[] = {TEXTOID};
+	Datum		values[] = {CStringGetTextDatum(realcard_query_key)};
+	HASHCTL		control = {0};
+
+	cache = palloc0(sizeof(RealCardCache));
+	cache->query_key = pstrdup(realcard_query_key);
+	cache->user_id = GetUserId();
+	control.keysize = REALCARD_KEY_MAXLEN;
+	control.entrysize = sizeof(RealCardEntry);
+	control.hcxt = root->planner_cxt;
+	cache->entries = hash_create("realcard planner cache", 128, &control,
+								 HASH_ELEM | HASH_STRINGS | HASH_CONTEXT);
+	realcard_loading = true;
+	PG_TRY();
+	{
+		if (SPI_connect() != SPI_OK_CONNECT)
+			elog(ERROR, "realcard: SPI_connect failed");
+		connected = true;
+		if (SPI_execute_with_args("SELECT relids, rows::float8 FROM realcard.cardinality WHERE query_key = $1",
+								  1, argtypes, values, NULL, true, 0) != SPI_OK_SELECT)
+			elog(ERROR, "realcard: could not read cardinalities");
+		if (SPI_gettypeid(SPI_tuptable->tupdesc, 1) != TEXTOID)
+			ereport(ERROR,
+					(errcode(ERRCODE_DATATYPE_MISMATCH),
+					 errmsg("realcard: relation subset keys must have type text")));
+		if (SPI_processed == 0)
+			ereport(ERROR,
+					(errcode(ERRCODE_INVALID_PARAMETER_VALUE),
+					 errmsg("realcard: no cardinalities for query key \"%s\"", cache->query_key)));
+		for (uint64 index = 0; index < SPI_processed; index++)
+		{
+			HeapTuple	tuple = SPI_tuptable->vals[index];
+			TupleDesc	descriptor = SPI_tuptable->tupdesc;
+			bool		isnull;
+			bool		found;
+			Datum		value;
+			char	   *key;
+			double		rows;
+			RealCardEntry *entry;
+
+			value = SPI_getbinval(tuple, descriptor, 1, &isnull);
+			if (isnull)
+				elog(ERROR, "realcard: null relation subset key");
+			key = TextDatumGetCString(value);
+			realcard_validate_key(root, key);
+			value = SPI_getbinval(tuple, descriptor, 2, &isnull);
+			if (isnull)
+				elog(ERROR, "realcard: null row count");
+			rows = DatumGetFloat8(value);
+			if (!isfinite(rows) || rows < 0)
+				ereport(ERROR,
+						(errcode(ERRCODE_INVALID_PARAMETER_VALUE),
+						 errmsg("realcard: invalid row count for subset \"%s\"", key)));
+			entry = hash_search(cache->entries, key, HASH_ENTER, &found);
+			if (found)
+				ereport(ERROR,
+						(errcode(ERRCODE_INVALID_PARAMETER_VALUE),
+						 errmsg("realcard: duplicate relation subset key \"%s\"", key)));
+			entry->rows = rows;
+			pfree(key);
+		}
+		SPI_finish();
+		connected = false;
+		realcard_loading = false;
+	}
+	PG_CATCH();
+	{
+		if (connected)
+			SPI_finish();
+		realcard_loading = false;
+		MemoryContextSwitchTo(oldcontext);
+		PG_RE_THROW();
+	}
+	PG_END_TRY();
+	SetPlannerInfoExtensionState(root, realcard_extension_id, cache);
+	root->glob->relationOids = lappend_oid(root->glob->relationOids,
+										   get_relname_relid("cardinality", get_namespace_oid("realcard", false)));
+	MemoryContextSwitchTo(oldcontext);
+	return cache;
+}
+
+static double
+realcard_lookup_rows(PlannerInfo *root, RelOptInfo *rel, double native_rows)
+{
+	RealCardCache *cache;
+	RealCardEntry *entry;
+	StringInfoData key;
+	int			member = -1;
+
+	if (realcard_loading || realcard_query_key == NULL || realcard_query_key[0] == '\0')
+		return native_rows;
+	if (realcard_extension_id < 0)
+		realcard_extension_id = GetPlannerExtensionId("realcard");
+	cache = GetPlannerInfoExtensionState(root, realcard_extension_id);
+	if (cache == NULL)
+	{
+		realcard_check_scope(root);
+		cache = realcard_load_cache(root);
+	}
+	if (strcmp(cache->query_key, realcard_query_key) != 0 || cache->user_id != GetUserId())
+		elog(ERROR, "realcard: replay key or role changed during planning");
+	if (rel->reloptkind != RELOPT_BASEREL && rel->reloptkind != RELOPT_JOINREL)
+		ereport(ERROR,
+				(errcode(ERRCODE_FEATURE_NOT_SUPPORTED),
+				 errmsg("realcard replay does not support inheritance members")));
+	initStringInfo(&key);
+	while ((member = bms_next_member(rel->relids, member)) >= 0)
+		appendStringInfo(&key, "%s%d", key.len == 0 ? "" : ",", member);
+	if (key.len == 0 || key.len >= REALCARD_KEY_MAXLEN)
+		ereport(ERROR,
+				(errcode(ERRCODE_PROGRAM_LIMIT_EXCEEDED),
+				 errmsg("realcard: relation subset key exceeds the supported size")));
+	entry = hash_search(cache->entries, key.data, HASH_FIND, NULL);
+	if (entry == NULL)
+		ereport(ERROR,
+				(errcode(ERRCODE_INVALID_PARAMETER_VALUE),
+				 errmsg("realcard: missing cardinality for query key \"%s\", subset \"%s\"",
+						cache->query_key, key.data)));
+	pfree(key.data);
+	return clamp_row_est(entry->rows);
+}
+
+double
+realcard_baserel_rows(PlannerInfo *root, RelOptInfo *rel, double native_rows)
+{
+	return realcard_lookup_rows(root, rel, native_rows);
+}
+
+double
+realcard_joinrel_rows(PlannerInfo *root, RelOptInfo *rel, double native_rows)
+{
+	return realcard_lookup_rows(root, rel, native_rows);
+}
